@baseUrl = http://localhost:8080
# Для новой операции задай новый UUID; для повтора оставь прежний ключ.
@taskRequestKey = 26e70a2e-088e-44a1-8a5e-55e3f48b2d64
@commentRequestKey = 447e9d68-72f5-4cbf-910b-e864ad9b584c

### Зарегистрировать владельца (один раз для каждого email)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "owner@example.test",
  "displayName": "Owner",
  "password": "Change-this-password-123"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

### Войти повторно, если пользователь уже зарегистрирован или токен истёк
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "owner@example.test",
  "password": "Change-this-password-123"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

### Текущий пользователь
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{accessToken}}

### 1. Создать рабочее пространство
POST {{baseUrl}}/api/v1/workspaces
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Backend team",
  "description": "Учебные проекты на Java"
}

> {% client.global.set("workspaceEtag", response.headers.valueOf("ETag")); client.global.set("workspaceId", response.body.id); %}

### 2. Создать проект
POST {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "TeamFlow",
  "description": "Система управления командными проектами"
}

> {% client.global.set("projectEtag", response.headers.valueOf("ETag")); client.global.set("projectId", response.body.id); %}

### 3. Создать задачу
POST {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks
Idempotency-Key: {{taskRequestKey}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Реализовать REST API",
  "description": "CRUD, DTO, валидация и обработка ошибок",
  "status": "TODO",
  "priority": "HIGH",
  "dueDate": "2026-12-31"
}

> {% client.global.set("taskEtag", response.headers.valueOf("ETag")); client.global.set("taskId", response.body.id); %}

### 4. Список задач с фильтрами и пагинацией
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks?status=TODO&priority=HIGH&page=0&size=20
Authorization: Bearer {{accessToken}}

### 5. Полное обновление изменяемых полей задачи
PUT {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}
If-Match: {{taskEtag}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Реализовать REST API",
  "description": "Первый этап готов",
  "status": "DONE",
  "priority": "HIGH",
  "dueDate": "2026-12-31"
}

> {% client.global.set("taskEtag", response.headers.valueOf("ETag")); %}

### 6. Получить задачу
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}

> {% client.global.set("taskEtag", response.headers.valueOf("ETag")); %}

### 7. Список проектов
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects?page=0&size=20
Authorization: Bearer {{accessToken}}

### 8. Список рабочих пространств
GET {{baseUrl}}/api/v1/workspaces?page=0&size=20
Authorization: Bearer {{accessToken}}

### 9. Health
GET {{baseUrl}}/actuator/health

### Зарегистрировать второго пользователя (токен владельца сохраняется)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "member@example.test",
  "displayName": "Member",
  "password": "Another-password-123"
}

> {% client.global.set("memberId", response.body.user.id); client.global.set("memberToken", response.body.accessToken); %}

### Владелец добавляет участника в команду
POST {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/members
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "member@example.test",
  "role": "MEMBER"
}

### Владелец добавляет участника в конкретный проект
POST {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/members
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"userId": "{{memberId}}"}

### Участник читает проекты своей команды
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects
Authorization: Bearer {{memberToken}}

### Попытка участника создать проект — ожидается 403
POST {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{"name": "Forbidden project"}

> {% client.global.set("projectEtag", response.headers.valueOf("ETag")); %}

### Назначить исполнителя задачи
PUT {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}/assignee
If-Match: {{taskEtag}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"userId": "{{memberId}}"}

> {% client.global.set("taskEtag", response.headers.valueOf("ETag")); %}

### Задачи исполнителя
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks?assigneeId={{memberId}}
Authorization: Bearer {{memberToken}}

### Участник добавляет комментарий
POST {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}/comments
Idempotency-Key: {{commentRequestKey}}
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{"body": "Проверил API, всё работает."}

> {% client.global.set("commentEtag", response.headers.valueOf("ETag")); client.global.set("commentId", response.body.id); %}

### Автор редактирует комментарий
PUT {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}/comments/{{commentId}}
If-Match: {{commentEtag}}
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{"body": "Проверил API и назначение исполнителя."}

> {% client.global.set("commentEtag", response.headers.valueOf("ETag")); %}

### Комментарии задачи
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}/comments?page=0&size=20
Authorization: Bearer {{accessToken}}

### История статусов — включает создание и прежнее изменение TODO → DONE
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}/history?page=0&size=20
Authorization: Bearer {{accessToken}}

### Список участников
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/members
Authorization: Bearer {{accessToken}}

### Владелец удаляет участника; его прежний токен больше не даёт доступ к команде
DELETE {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/members/{{memberId}}
Authorization: Bearer {{accessToken}}

### Исполнитель снят автоматически, комментарии сохранены
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}

> {% client.global.set("taskEtag", response.headers.valueOf("ETag")); %}

### Очистка: удалить задачу вместе с комментариями и историей
DELETE {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/tasks/{{taskId}}
If-Match: {{taskEtag}}
Authorization: Bearer {{accessToken}}

### Получить актуальную версию проекта перед архивированием
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}
Authorization: Bearer {{accessToken}}

> {% client.global.set("projectEtag", response.headers.valueOf("ETag")); %}

### Архивировать проект без удаления данных
PUT {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/archive
Authorization: Bearer {{accessToken}}
If-Match: {{projectEtag}}
Content-Type: application/json

{"archived":true}

> {% client.global.set("projectEtag", response.headers.valueOf("ETag")); %}

### Список архивных проектов
GET {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects?archived=true
Authorization: Bearer {{accessToken}}

### Восстановить проект
PUT {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/projects/{{projectId}}/archive
Authorization: Bearer {{accessToken}}
If-Match: {{projectEtag}}
Content-Type: application/json

{"archived":false}

> {% client.global.set("projectEtag", response.headers.valueOf("ETag")); %}
